{
  "name": "stockflow-contracts",
  "version": "1.0.0",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat run --network robinhoodTestnet scripts/deploy.ts",
    "e2e:testnet": "hardhat run --network robinhoodTestnet scripts/e2e.ts",
    "verify:testnet": "bash scripts/verify.sh",
    "deploy:mainnet": "hardhat run --network robinhoodMainnet scripts/deploy-mainnet.ts",
    "deploy:mainnet:dry": "DRY_RUN=1 hardhat run --network robinhoodMainnet scripts/deploy-mainnet.ts"
  },
  "license": "MIT",
  "description": "StockFlow protocol contracts (Robinhood Chain)",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "hardhat": "^3.16.0"
  },
  "type": "module",
  "private": true
}
